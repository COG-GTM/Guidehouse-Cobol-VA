  classDef evid fill:#EBEEF2,stroke:#5E7488,stroke-width:1.5px,color:#2B3A47;
  class H1,H2,H3,H4,H5 human;
  class F1,EMIT factory;
  class GATE gate;
  class E1,E2,E3,E4 evid;
